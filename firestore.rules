rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if user belongs to the festival
    // Supports both old (festivalId field) and new (festivals array) schema
    function belongsToFestival(festivalId) {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isSignedIn() && (
        // New schema: check simple festivalIds array
        (userDoc.festivalIds != null && festivalId in userDoc.festivalIds) ||
        // Old schema: check festivalId field
        (userDoc.festivalId == festivalId)
      );
    }

    // Helper function to check if user is admin or owner
    // Supports both old and new schema
    function isAdminOrOwner(festivalId) {
      return isSignedIn() &&
        (get(/databases/$(database)/documents/festivals/$(festivalId)).data.ownerId == request.auth.uid ||
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.festivals != null &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.festivals.hasAny([{festivalId: festivalId, role: 'admin'}])) ||
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.festivalId == festivalId &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    // Users collection - Allow owners to query by email for invitations
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (
        // Users can update their own document
        request.auth.uid == userId ||
        // Admins/owners can remove users from their festivals
        canRemoveUserFromFestival(userId)
      );
      allow delete: if false;
      // Allow listing/querying users for invitation checks
      allow list: if isSignedIn();
    }

    // Helper function to check if current user owns a specific festival
    function isOwnerOfFestival(festivalId) {
      return get(/databases/$(database)/documents/festivals/$(festivalId)).data.ownerId == request.auth.uid;
    }

    // Helper function to check if current user can remove another user from a festival
    function canRemoveUserFromFestival(targetUserId) {
      // Check if festivals are being removed
      let hasFestivalIds = request.resource.data.festivalIds != null && resource.data.festivalIds != null;
      let oldFestivalIds = resource.data.festivalIds;

      // Check if festivals array is being reduced
      let festivalsReduced = hasFestivalIds &&
        request.resource.data.festivalIds.size() < resource.data.festivalIds.size();

      // Check if current user is the owner of any festival the target user belongs to
      // Due to Firestore rules limitations, we check up to the first 3 festivals
      let ownsTargetUserFestival = oldFestivalIds != null && oldFestivalIds.size() > 0 && (
        (oldFestivalIds.size() >= 1 && oldFestivalIds[0] != null && isOwnerOfFestival(oldFestivalIds[0])) ||
        (oldFestivalIds.size() >= 2 && oldFestivalIds[1] != null && isOwnerOfFestival(oldFestivalIds[1])) ||
        (oldFestivalIds.size() >= 3 && oldFestivalIds[2] != null && isOwnerOfFestival(oldFestivalIds[2]))
      );

      return isSignedIn() && festivalsReduced && ownsTargetUserFestival;
    }

    // Invitations collection - Root level (for signup/invitation lookups)
    // Allow unauthenticated read so users can see invitation details before logging in
    // Invitations are one-time use and don't contain sensitive data
    match /invitations/{invitationId} {
      allow read: if true;  // Anyone can read invitations
      allow write: if isSignedIn();  // Only authenticated users can create/update invitations
    }

    // Festivals collection
    match /festivals/{festivalId} {
      allow read: if isSignedIn() && (
        belongsToFestival(festivalId) ||
        resource.data.ownerId == request.auth.uid
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        belongsToFestival(festivalId) ||
        resource.data.ownerId == request.auth.uid
      );
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      // Gear subcollection - only accessible to festival members
      match /gear/{gearId} {
        allow read, write: if belongsToFestival(festivalId);
      }

      // Locations subcollection
      match /locations/{locationId} {
        allow read, write: if belongsToFestival(festivalId) || isAdminOrOwner(festivalId);
      }

      // Performances subcollection
      match /performances/{performanceId} {
        allow read, write: if belongsToFestival(festivalId);
      }

      // Scans subcollection
      match /scans/{scanId} {
        allow read, write: if belongsToFestival(festivalId);
      }

      // Messages subcollection - Admin/Owner can write, all can read
      match /messages/{messageId} {
        allow read: if belongsToFestival(festivalId);
        allow write: if isAdminOrOwner(festivalId);
      }

      // Message reads subcollection - Users can track their own read status
      match /message_reads/{readId} {
        allow read: if belongsToFestival(festivalId);
        allow create: if belongsToFestival(festivalId) && request.resource.data.user_id == request.auth.uid;
        allow delete: if belongsToFestival(festivalId);
      }

      // NEW: Bands collection
      match /bands/{bandId} {
        allow read: if belongsToFestival(festivalId);
        allow write: if belongsToFestival(festivalId);
      }

      // NEW: Reminders collection (user's personal reminders within festival context)
      match /reminders/{reminderId} {
        allow read: if belongsToFestival(festivalId) && resource.data.userId == request.auth.uid;
        allow create: if belongsToFestival(festivalId) && request.resource.data.userId == request.auth.uid;
        allow update: if belongsToFestival(festivalId) && resource.data.userId == request.auth.uid;
        allow delete: if belongsToFestival(festivalId) && resource.data.userId == request.auth.uid;
      }

      // Containers collection - Admin/Owner can write, all can read
      match /containers/{containerId} {
        allow read: if belongsToFestival(festivalId);
        allow write: if isAdminOrOwner(festivalId);
      }

      // Stowage items collection - Admin/Owner can write, all can read
      match /stowage_items/{stowageId} {
        allow read: if belongsToFestival(festivalId);
        allow write: if isAdminOrOwner(festivalId);
      }
    }
  }
}
